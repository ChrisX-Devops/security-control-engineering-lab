{
  "security_groups": [
    {
      "name": "web-tier-prod",
      "vpc": "vpc-prod-001",
      "inbound_rules": [
        {"port": 443, "cidr": "0.0.0.0/0"},
        {"port": 80,  "cidr": "0.0.0.0/0"}
      ]
    },
    {
      "name": "ssh-management",
      "vpc": "vpc-prod-001",
      "inbound_rules": [
        {"port": 22, "cidr": "0.0.0.0/0"}
      ]
    },
    {
      "name": "database-tier",
      "vpc": "vpc-prod-001",
      "inbound_rules": [
        {"port": 5432, "cidr": "0.0.0.0/0"},
        {"port": 3306, "cidr": "10.0.0.0/8"}
      ]
    },
    {
      "name": "internal-services",
      "vpc": "vpc-prod-001",
      "inbound_rules": [
        {"port": 22,    "cidr": "10.0.1.0/24"},
        {"port": 8080,  "cidr": "10.0.0.0/16"},
        {"port": 27017, "cidr": "10.0.5.0/24"}
      ]
    }
  ]
}
